# Weaviate
WEAVIATE_PORT=8090
WEAVIATE_GRPC_PORT=50051
PRODUCTS_COLLECTION_NAME=products

# Ollama
OLLAMA_ENDPOINT=http://host.docker.internal:11434

# Models — split by task, since they don't behave the same across tasks
# (deepseek-r1 tested more accurate for intent classification, but does not
# reliably respect JSON Schema constraints, so metadata extraction uses llama3.2)
INTENT_CLASSIFICATION_MODEL=deepseek-r1:7b
METADATA_EXTRACTION_MODEL=llama3.2
GENERATION_MODEL=llama3.2
EMBEDDING_MODEL=nomic-embed-text

# Retrieval
DEFAULT_SEARCH_LIMIT=20
MIN_RESULTS_THRESHOLD=10
FALLBACK_RESULTS_THRESHOLD=5

# Chat memory
MAX_CHAT_MEMORY_TURNS=6

# Data paths
DATA_DIR=data
